# Export these variables into the application process; .env is not auto-loaded.
DATABASE_URL=postgres://ksi:ksi-local-development@127.0.0.1:5432/ksi?sslmode=disable
KSI_MODE=all
KSI_LISTEN=127.0.0.1:8080
KSI_DEV_IDENTITY=true
KSI_ARTIFACT_DIRECTORY=.data/artifacts
# Production browser identity (development identity must be false):
# KSI_PUBLIC_URL=https://ksi.example.com
# KSI_OIDC_ISSUER=https://identity.example.com
# KSI_OIDC_CLIENT_ID=
# KSI_OIDC_CLIENT_SECRET=
# KSI_ADMIN_SUBJECT=
