{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "src/**",
      "*.json",
      "*.ts",
      "!package-lock.json",
      "!src/generated.ts",
      "!openapi.json"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "linter": { "enabled": true, "rules": { "recommended": true } }
}
